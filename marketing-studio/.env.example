# Copia este archivo a .env.local y completa los valores.

# --- Públicas (van al navegador; la seguridad la dan las políticas RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon

# --- Almacenamiento de la Biblioteca ---
# "supabase" (por defecto y en producción): bucket privado "mkt-assets".
# "local": SOLO desarrollo; guarda en .local-storage/ de este equipo. No funciona en Netlify ni Vercel.
# MKT_STORAGE_BACKEND=local

# --- Secretas: SOLO en el servidor / hosting. Nunca con prefijo NEXT_PUBLIC_ ---
# Gemini API (nivel gratuito, OPCIONAL). Crea la clave en https://aistudio.google.com/apikey
# en un proyecto de Google Cloud SIN facturación activa. La app solo la usa si además
# GEMINI_FREE_TIER_CONFIRMED=1 (tu confirmación de que ese proyecto no tiene facturación).
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=
# GEMINI_MODEL=gemini-2.5-flash

# Búsqueda web con Tavily (OPCIONAL, plan gratuito de 1 000 créditos/mes sin tarjeta).
TAVILY_API_KEY=

# Montaje de video (opcional): ruta de FFmpeg y de una fuente TTF para los textos en pantalla.
# En Netlify no hay FFmpeg: la app muestra el comando para montarlo en tu computadora.
# MKT_FFMPEG_PATH=/usr/bin/ffmpeg
# MKT_VIDEO_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Correo de contacto que se envía a OpenStreetMap/Nominatim, como pide su política de uso.
MKT_CONTACT_EMAIL=

# --- Conexión oficial con Meta (opcional). La app de Meta la creas tú (gratis). ---
META_APP_ID=
META_APP_SECRET=
# URL pública del sitio (en Netlify, si falta se usa la variable URL que Netlify define).
MKT_APP_URL=
# META_GRAPH_VERSION=v26.0
# Solo para guardar tokens de Meta cifrados y marcar «Conectado». Secreta. Nada más la usa.
SUPABASE_SERVICE_ROLE_KEY=
# 32 bytes en base64 para cifrar tokens: openssl rand -base64 32
MKT_TOKEN_KEY=

# --- Publicación automática (APAGADA por defecto) ---
# Solo con «1» la app publica lo que el dueño aprobó, a la hora programada.
MKT_PUBLISHING_ENABLED=
# Secreto (24+ caracteres) que usa la función programada de Netlify: openssl rand -base64 32
MKT_CRON_SECRET=
