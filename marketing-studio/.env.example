# Copia este archivo a .env.local y completa los valores.

# --- Públicas (van al navegador; la seguridad la dan las políticas RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon

# --- Almacenamiento de la Biblioteca ---
# "supabase" (por defecto y en producción): bucket privado "mkt-assets".
# "local": SOLO desarrollo; guarda en .local-storage/ de este equipo. No funciona en Vercel.
# MKT_STORAGE_BACKEND=local

# --- Secretas: SOLO en el servidor / hosting. Nunca con prefijo NEXT_PUBLIC_ ---
# Gemini API (nivel gratuito). Crea la clave en https://aistudio.google.com/apikey
# en un proyecto de Google Cloud SIN facturación activa. Se usará en la Etapa 3.
GEMINI_API_KEY=

# Meta for Developers (Etapa 5). La app de Meta la creas tú.
META_APP_ID=
META_APP_SECRET=
