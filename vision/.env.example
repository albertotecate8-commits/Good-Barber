# Smart Business Vision AI — variables de entorno del FRONTEND.
# Copia este archivo a .env.local y completa los valores.
#
# Todas son PÚBLICAS por diseño (quedan dentro del JavaScript que descarga el
# navegador). La seguridad real la dan las políticas RLS de Supabase.
#
# NUNCA pongas aquí la service_role key, la contraseña del usuario del motor,
# contraseñas de cámaras ni URLs RTSP. Esas credenciales solo viven en el
# servidor de procesamiento (motor de visión), nunca en el frontend ni en el
# repositorio. La service_role no la usa nadie: ni la app ni el motor.

# Proyecto de Supabase EXCLUSIVO de Smart Business Vision.
# No uses el de Good Barber ni el de Finanzas: la app se niega a arrancar con ellos.
# Project URL (Supabase → Project Settings → API / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publishable / anon (Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Esquema de Postgres donde viven las tablas de la app. Debe estar en
# Supabase → Project Settings → Data API → Exposed schemas.
NEXT_PUBLIC_SUPABASE_SCHEMA=vision
